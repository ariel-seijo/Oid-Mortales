# =============================================================================
# Oíd Mortales — Variables de entorno
# =============================================================================
# Copiá este archivo como .env.local y ajustá los valores según necesites.
#
# El archivo .env.local está en .gitignore y nunca se commitea.
# =============================================================================

# (Por ahora ninguna variable es obligatoria. La app funciona con datos de ejemplo
# que se copian automáticamente desde historia.example.ts durante npm install.)
#
# En producción, configurá las siguientes variables en tu plataforma de deploy:
# -----------------------------------------------------------------------------

# URL base del sitio (usada para canonical URLs y sitemap)
# NEXT_PUBLIC_SITE_URL=https://oid-mortales.vercel.app
